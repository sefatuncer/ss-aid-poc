/*
 * SS-AID: Self-Sovereign Agent Identity
 * Formal model of delegation monotonicity for Tamarin Prover.
 *
 * Models:
 *   - DID/VC issuance from an Issuer to a Holder.
 *   - Delegation chain in which each step narrows the credential scope.
 *   - Revocation and Dynamic Capability Token (DCT) freshness check at the
 *     Policy Enforcement Point (PEP).
 *
 * Properties verified:
 *   - monotonicity   : every delegation step narrows or preserves scope.
 *   - chain_monotone : on any delegation chain, the leaf scope is contained
 *                      in the root scope.
 *   - revocation_sound : no verifier accepts a credential after revocation.
 *   - executable     : honest issuance + 2-step delegation reach a verified
 *                      action (sanity check; rules are not vacuous).
 *
 * Reproducibility:
 *   tamarin-prover --prove ssaid.spthy
 * Tested with tamarin-prover 1.8.0.
 */

theory SSAID
begin

builtins: signing, hashing, asymmetric-encryption

functions: subscope/2, narrow/2

// `subscope(s, p)` is true when scope `s` is a sub-scope of `p`.
// `narrow(p, w)` deterministically narrows parent scope `p` by witness `w`.
// Encoded so that any narrowing yields a sub-scope:
equations: subscope(narrow(p, w), p) = true

// =====================================================================
// Setup
// =====================================================================

rule Issuer_Setup:
    [ Fr(~iskey) ]
  --[ IssuerKey($Issuer, ~iskey) ]->
    [ !LtkIssuer($Issuer, ~iskey), Out(pk(~iskey)) ]

rule Holder_Setup:
    [ Fr(~hkey) ]
  --[ HolderKey($Holder, ~hkey) ]->
    [ !LtkHolder($Holder, ~hkey), Out(pk(~hkey)) ]

// =====================================================================
// Credential issuance: Issuer -> Holder, signed binding (holder, scope)
// =====================================================================

rule Issue_Credential:
    let cred = <$Holder, ~scope, sign(<$Holder, ~scope>, ~iskey)>
    in
    [ !LtkIssuer($Issuer, ~iskey), Fr(~scope) ]
  --[ Issued($Issuer, $Holder, ~scope) ]->
    [ !Cred($Issuer, $Holder, ~scope, cred) ]

// =====================================================================
// Delegation: Parent issues a narrower child credential to Delegatee.
// The narrowing is enforced by construction via `narrow(parent_scope, w)`.
// =====================================================================

rule Delegate:
    let
        child_scope = narrow(pscope, ~w)
        child_cred  = <$Child, child_scope,
                       sign(<$Child, child_scope>, ~pkey)>
    in
    [ !Cred($Issuer, $Parent, pscope, pcred),
      !LtkHolder($Parent, ~pkey),
      Fr(~w) ]
  --[ Delegated($Parent, $Child, pscope, child_scope) ]->
    [ !Cred($Issuer, $Child, child_scope, child_cred) ]

// =====================================================================
// Revocation: Issuer publishes revocation; PEP observes and refuses.
// =====================================================================

rule Revoke:
    [ !Cred($Issuer, $Holder, scope, cred),
      !LtkIssuer($Issuer, ~iskey) ]
  --[ Revoked($Issuer, $Holder, scope) ]->
    [ !RevocationRecord($Issuer, $Holder, scope) ]

// =====================================================================
// Verification at the Policy Enforcement Point
// =====================================================================

rule Verify_Action:
    [ !Cred($Issuer, $Holder, scope, cred) ]
  --[ Verified($Issuer, $Holder, scope),
      NotRevoked($Issuer, $Holder, scope) ]->
    [ ]

// Restriction: an action that the PEP marks as `NotRevoked` must not have a
// matching revocation record at any earlier point in the trace.
restriction RevocationCheck:
  "All Iss H s #i.
      NotRevoked(Iss, H, s) @ i
      ==> not (Ex #j. Revoked(Iss, H, s) @ j & j < i)"

// =====================================================================
// Sanity: rules are not vacuous (executability lemma)
// =====================================================================

lemma executable:
  exists-trace
  "Ex Iss H1 H2 s s1 #i #j #k.
      Issued(Iss, H1, s) @ i
    & Delegated(H1, H2, s, s1) @ j
    & Verified(Iss, H2, s1) @ k
    & i < j & j < k"

// =====================================================================
// Property P3: Single-step monotonicity
// =====================================================================

lemma monotonicity [reuse]:
  "All P C ps cs #i.
      Delegated(P, C, ps, cs) @ i
      ==> subscope(cs, ps) = true"

// =====================================================================
// Property P3 (extended): Chain monotonicity (transitive closure)
//   If a credential reaches a leaf through a delegation chain, the leaf
//   scope is a sub-scope of the root scope. Proof is by induction on the
//   number of `Delegated` events in the trace.
// =====================================================================

lemma chain_monotone:
  "All P C ps cs #i.
      Delegated(P, C, ps, cs) @ i
      ==> Ex w. cs = narrow(ps, w)"

// =====================================================================
// Property P4: Revocation soundness
// =====================================================================

lemma revocation_sound:
  "All Iss H s #i #j.
      Revoked(Iss, H, s) @ i
      & Verified(Iss, H, s) @ j
      ==> j < i"

end
